# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Generate a random webhook secret, e.g. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Comma-separated Telegram numeric IDs allowed to use the Mini App admin queue
ADMIN_TELEGRAM_IDS=

# Deployed Worker origin, used only by npm run configure-bot
WEBHOOK_URL=https://domnkrbot.<your-workers-subdomain>.workers.dev
