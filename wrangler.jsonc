{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domnkrbot",
  "main": "src/live-entry-v3.ts",
  "build": {
    "command": "npm run typecheck && npm test && node scripts/write-deploy-revision.mjs"
  },
  "compatibility_date": "2026-08-14",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "placement": {
    "mode": "smart"
  },
  "limits": {
    "subrequests": 10000
  },
  "vars": {
    "BOT_USERNAME": "domnekromanta_bot",
    "PUBLISH_CHANNEL_ID": "@domnekromanta",
    "RANOBELIB_TEAM_REF": "11969--dom-nekromanta"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN"
    ]
  },
  "triggers": {
    "crons": ["* * * * *", "17 */3 * * *", "*/30 * * * *", "*/5 * * * *", "0 * * * *"]
  },
  "queues": {
    "producers": [
      {
        "binding": "NOTIFICATION_QUEUE",
        "queue": "domnkrbot-notifications-v3"
      }
    ],
    "consumers": [
      {
        "queue": "domnkrbot-notifications-v3",
        "max_batch_size": 1,
        "max_batch_timeout": 1,
        "max_retries": 3,
        "max_concurrency": 1
      }
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/media/*", "/telegram/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domnkrbot-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
}