{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domnkrbot",
  "main": "src/live-entry-v2.ts",
  "compatibility_date": "2026-08-14",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BOT_USERNAME": "domnekromanta_bot",
    "PUBLISH_CHANNEL_ID": "@domnekromanta",
    "RANOBELIB_TEAM_REF": "11969--dom-nekromanta",
    "RANOBELIB_SYNC_BATCH_SIZE": "16"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN"
    ]
  },
  "triggers": {
    "crons": ["*/10 * * * *"]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/auth/*", "/media/*", "/telegram/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domnkrbot-db",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES"
    }
  ]
}
