{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domnkrbot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BOT_USERNAME": "domnekromanta_bot"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN",
      "TELEGRAM_WEBHOOK_SECRET",
      "ADMIN_TELEGRAM_IDS"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domnkrbot-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
