{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "domnkrbot",
  "main": "src/worker.ts",
  "compatibility_date": "2026-08-14",
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "BOT_USERNAME": "domnekromanta_bot"
  },
  "secrets": {
    "required": [
      "TELEGRAM_BOT_TOKEN"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/telegram/*", "/setup"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "domnkrbot-db",
      "migrations_dir": "migrations"
    }
  ]
}
